# Formulaire de contact — à recopier dans .env.local pour le développement,
# et à déclarer dans Vercel (Project Settings → Environment Variables) pour la production.
#
#   vercel env add RESEND_API_KEY production
#
# .env.local est ignoré par git : la vraie clé ne doit jamais être commitée.

# Clé d'envoi Resend — https://resend.com/api-keys (permission « Sending access »)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Boîte qui reçoit les messages du formulaire.
# À basculer sur contact@chadia-ong.org dès que la boîte partagée existe.
CONTACT_TO=tidjani@chadia-ong.org

# Expéditeur technique. Le domaine doit être vérifié dans Resend.
# Jamais l'adresse du visiteur : elle va dans Reply-To (voir contact/actions.ts).
CONTACT_FROM=Site CHADIA <formulaire@chadia-ong.org>
